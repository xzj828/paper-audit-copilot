      "parse": {
        "id": "parse-ecology-cn",
        "sections": [
          {
            "id": "design",
            "title": "研究设计",
            "text": "处理分配单位为样地，共30个独立样地，每处理15个；每样地采集10份土壤子样。"
          },
          {
            "id": "stats",
            "title": "统计分析",
            "text": "先将子样汇总为样地均值。以处理为固定效应、区组为随机截距拟合线性混合模型，报告95%置信区间。"
          },
          {
            "id": "carbon",
            "title": "结果",
            "text": "同一天测得表层土壤碳储量4千克碳每平方米。本次储量测量不代表年固碳通量。"
          },
          {
            "id": "quality",
            "title": "测量质控",
            "text": "叶绿素测量包含每批空白与标准物质，仪器异常时复测。"
          },
          {
            "id": "limits",
            "title": "局限性",
            "text": "外推范围限于本站点、本年度与表层土壤，不声称所有森林具有同一响应。"
          },
          {
            "id": "data",
            "title": "可复现性",
            "text": "数据与代码位于机构仓库，原始观测表包含处理分配和样地编号。"
          }
        ]
      },
