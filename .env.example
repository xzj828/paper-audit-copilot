PORT=3001
HOST=127.0.0.1
# Persistent storage; never commit uploaded papers or the SQLite database.
DATA_DIR=./data

# Development launcher only: opt in to API auto-restart when no review is running.
# PAPER_AUDIT_API_WATCH=1

# Set after deploying behind an HTTPS reverse proxy. Enables Secure cookies and exact origin checks.
# PUBLIC_ORIGIN=https://papers.example.com

# Optional Brave credential for other models. Official DeepSeek connections reuse their model key for search.
# BRAVE_SEARCH_API_KEY=
