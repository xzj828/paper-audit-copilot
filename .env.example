# Copy this file to .env in the repository root. Never commit the real .env.
# npm run dev / npm start / npm run account / npm run model:configure load it.
# Existing process environment variables take precedence over .env values.

# Web server and persistent storage. Use the SAME DATA_DIR for all admin commands.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data

# Optional model provisioning for ONE existing account:
# 1. Fill the three values below using your provider's actual settings.
# 2. Run: npm run model:configure -- sample-reviewer
# The command encrypts and saves the model for that account and enables it.
# Changing these variables alone does not change a saved model; rerun the command.
# Already configured through Settings? Leave these blank; existing models still work.
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
# Enable only if this model accepts image_url input for PDF visual review.
MODEL_VISION=false

# HTTPS deployment only. Exact public origin, without a path or trailing slash.
# Leave unset for http://127.0.0.1 or an HTTP IP demo; otherwise cookies cannot log in.
# PUBLIC_ORIGIN=https://papers.example.com

# Optional web search for models other than an enabled official DeepSeek connection.
# Server-level fallback for accounts without their own Brave key; incurs provider fees.
# BRAVE_SEARCH_API_KEY=

# Windows only: Chrome executable for PDF export (default shown). Not needed on
# other platforms after: npx playwright install --with-deps chromium
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Development only: when PORT changes, point Vite at the matching API port.
# API_PROXY_TARGET=http://127.0.0.1:3001
# Opt in to API file watching only when no review is running.
# PAPER_AUDIT_API_WATCH=1

# Account creation/reset only. Omit to generate a random password.
# Remove after provisioning. Never put real passwords in public files.
# ACCOUNT_PASSWORD=
